 	size_t			size;
 	u8			fcs_len;
 	bool			mapped_as_page;
+	u32			zcudp_flag;	/* fcfb zcudp: BD tag, 0 for skb BDs */
 };
 
 /* Hardware-collected statistics. Used when updating the network
@@ -1281,6 +1282,7 @@
 	dma_addr_t		tx_ring_dma;
 	struct work_struct	tx_error_task;
 	bool			txubr_pending;
+	u32			zcudp_tx_inflight;	/* fcfb zcudp: BDs (skb+zcudp) in HW ring */
 	struct napi_struct	napi_tx;
 
 	dma_addr_t		rx_ring_dma;
@@ -1395,8 +1397,16 @@
 
 	struct macb_pm_data pm_data;
 	const struct macb_usrio_config *usrio;
+
+	struct zcudp_ctx	*zcudp;		/* fcfb in-kernel zero-copy UDP TX */
 };
 
+/* fcfb zcudp: TX-ring BD helpers shared with zcudp.c (de-static'd in macb_main.c) */
+unsigned int macb_tx_ring_wrap(struct macb *bp, unsigned int index);
+struct macb_dma_desc *macb_tx_desc(struct macb_queue *queue, unsigned int index);
+struct macb_tx_skb *macb_tx_skb(struct macb_queue *queue, unsigned int index);
+void macb_set_addr(struct macb *bp, struct macb_dma_desc *desc, dma_addr_t addr);
+
 #ifdef CONFIG_MACB_USE_HWSTAMP
 #define GEM_TSEC_SIZE  (GEM_TSH_SIZE + GEM_TSL_SIZE)
 #define TSU_SEC_MAX_VAL (((u64)1 << GEM_TSEC_SIZE) - 1)
diff --git a/drivers/net/ethernet/cadence/macb_main.c b/drivers/net/ethernet/cadence/macb_main.c
--- a/drivers/net/ethernet/cadence/macb_main.c	2026-09-27 13:49:45.852279248 -0400
