--- a/drivers/net/ethernet/cadence/Makefile	2026-09-27 13:49:45.849409884 -0400
+++ b/drivers/net/ethernet/cadence/Makefile	2026-09-27 13:42:36.267955705 -0400
@@ -2,7 +2,7 @@
