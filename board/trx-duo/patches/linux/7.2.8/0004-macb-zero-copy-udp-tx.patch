@@ -1221,7 +1222,7 @@
 	}
 }
 
-static void macb_set_addr(struct macb *bp, struct macb_dma_desc *desc, dma_addr_t addr)
+void macb_set_addr(struct macb *bp, struct macb_dma_desc *desc, dma_addr_t addr)
 {
 	if (macb_dma64(bp)) {
 		struct macb_dma_desc_64 *desc_64;
@@ -1414,11 +1415,14 @@
 	unsigned int tail;
 	unsigned int head;
 	int packets = 0;
+	int zcudp_frames = 0;
 	u32 bytes = 0;
+	bool zcudp_woke = false;
 
 	spin_lock_irqsave(&queue->tx_ptr_lock, flags);
 	head = queue->tx_head;
-	for (tail = queue->tx_tail; tail != head && packets < budget; tail++) {
+	for (tail = queue->tx_tail;
+	     tail != head && packets + zcudp_frames < budget; tail++) {
 		struct macb_tx_skb	*tx_skb;
 		struct sk_buff		*skb;
 		struct macb_dma_desc	*desc;
@@ -1440,6 +1444,29 @@
 		/* Process all buffers of the current transmitted frame */
 		for (;; tail++) {
 			tx_skb = macb_tx_skb(queue, tail);
+
+			/* Every reclaimed BD (skb or zcudp) frees one ring slot;
+			 * zcudp_tx_inflight tracks the shared ring occupancy so
+			 * the zcudp drain's free-BD math stays correct. */
+			if (queue->zcudp_tx_inflight)
+				queue->zcudp_tx_inflight--;
+
+			/* fcfb zcudp BDs carry no skb and are not dma_map'd:
+			 * recycle the tag, never macb_tx_unmap / kfree_skb. The
+			 * datagram's last BD is flagged COMPLETE (frame end). */
+			if (tx_skb->zcudp_flag & ZCUDP_BD_OWNED) {
+				bool done = tx_skb->zcudp_flag & ZCUDP_BD_COMPLETE;
+
+				tx_skb->zcudp_flag = 0;
+				tx_skb->skb = NULL;
+				zcudp_woke = true;
+				if (done) {
+					zcudp_frames++;
+					break;
+				}
+				continue;
+			}
+
 			skb = tx_skb->skb;
 
 			/* First, update TX stats if needed */
@@ -1481,6 +1508,10 @@
 		netif_wake_subqueue(bp->netdev, queue_index);
 	spin_unlock_irqrestore(&queue->tx_ptr_lock, flags);
 
+	/* fcfb zcudp: wake a drain that is blocked on GEM ring space. */
+	if (zcudp_woke)
+		zcudp_tx_wake(queue);
+
 	if (packets)
